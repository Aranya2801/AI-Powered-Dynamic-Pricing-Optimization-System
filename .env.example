# AI Dynamic Pricing System — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# Database
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://pricing_admin:changeme@localhost:5432/dynamic_pricing
REDIS_HOST=localhost

# Security (REQUIRED in production — generate via: openssl rand -hex 32)
API_SECRET_KEY=change-this-in-production

# Generative AI Advisor (optional)
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Competitor Intelligence (only needed if use_mock_data: false in config.yaml)
# COMPETITOR_API_ENDPOINT=https://api.priceintel.example.com/v1/prices
# COMPETITOR_API_KEY=...
